# Supabase → Connect → Transaction pooler (port 6543), with ?pgbouncer=true appended. Runtime queries.
DATABASE_URL=
# Supabase → Connect → Direct connection or Session pooler (port 5432). Prisma migrations only.
DIRECT_URL=
# Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable key. Browser auth and Realtime only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → secret key. Server only; sends Realtime broadcasts.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Postgres pool size per server instance (default 5).
DATABASE_POOL_MAX=

# Google AI Studio key. Gemini with Google Search finds official websites when no hint is given.
GOOGLE_GENERATIVE_AI_API_KEY=

# Local development only: talk to `pnpm inngest:dev` instead of Inngest Cloud. Without it the
# /api/inngest route answers 500 ("In cloud mode but no signing key found"). Never set in production.
INNGEST_DEV=1
# Inngest → Manage. Production only; not needed locally with INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Meta app "Roofing" (same values as contractor-sites). Server only. Used by `pnpm meta:token`.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
# Written by `pnpm meta:token` — a 60-day token and the Instagram business account it looks up from.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_TOKEN_EXPIRES_AT=
