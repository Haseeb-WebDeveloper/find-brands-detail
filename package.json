{
  "name": "brand-enrich",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "echo \"Use the migrate-diff workflow in AGENTS.md rule 6; migrate dev cannot run against Supabase here.\" && exit 1",
    "db:migrate:deploy": "prisma migrate deploy",
    "bootstrap": "tsx scripts/bootstrap-owner.ts",
    "verify:lockdown": "tsx scripts/verify-lockdown.ts",
    "verify:realtime": "tsx scripts/verify-realtime.ts",
    "test-set": "tsx --conditions=react-server scripts/test-set.ts",
    "meta:token": "tsx scripts/meta-token.ts",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3005/api/inngest"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/groq": "^4.0.63",
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "ai": "^7.0.143",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.0.4",
    "inngest": "^4.18.0",
    "lucide-react": "1.52.0",
    "motion": "12.43.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.4.2",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.5.0"
}
